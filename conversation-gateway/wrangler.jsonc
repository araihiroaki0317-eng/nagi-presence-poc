{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nagi-conversation-gateway-eval",
  "main": "cloudflare-entry.js",
  "compatibility_date": "2026-09-04",
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://araihiroaki0317-eng.github.io",
    "WORKERS_AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BUDGET_LEDGER",
        "class_name": "BudgetLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BudgetLedger"]
    }
  ]
}
